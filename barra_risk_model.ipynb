     "text": [
      "ModelConfig(start_date='2019-01-01', end_date=None, beta_window=252, momentum_lookback=252, momentum_gap=21, vol_window=63, reversal_window=21, size_window=63, liquidity_short=21, liquidity_long=126, winsor_z=3.0, weight_clip=(0.2, 5.0), min_names_per_date=40, factor_cov_halflife=90.0, specific_halflife=60.0, newey_west_lags=2, specific_shrinkage=0.25, validation_step=21, min_cov_obs=150, annualization=252, max_missing_frac=0.1, random_seed=42)\n"
     ]
    }
