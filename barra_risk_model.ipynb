    "def fmt_pct(ax, axis: str = \"y\") -> None:\n",
    "    \"\"\"Format an axis as percentages.\"\"\"\n",
    "    formatter = mtick.PercentFormatter(xmax=1.0)\n",
    "    (ax.yaxis if axis == \"y\" else ax.xaxis).set_major_formatter(formatter)\n",
